{
  "name": "block-survivors",
  "private": true,
  "version": "0.33.0",
  "description": "Survivor-like voxel en vue de dessus, esthétique Minecraft.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "app": "tsc --noEmit && vite build && electron .",
    "app:dev": "node scripts/app-dev.mjs",
    "exe": "tsc --noEmit && vite build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "opentype.js": "^2.0.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "fr.blocksurvivors.jeu",
    "productName": "Block Survivors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "electron/icone.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Block Survivors",
      "deleteAppDataOnUninstall": false,
      "artifactName": "BlockSurvivors-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TakeosOfficiel",
        "repo": "Block-Survivors-version",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
